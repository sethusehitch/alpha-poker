# Public port for the complete site.
ALPHA_POKER_PORT=8080

# Browser requests use the same origin and are routed by Caddy.
NEXT_PUBLIC_API_BASE_URL=/v1

# Change only if the FastAPI application module moves.
API_MODULE=app.main:app
API_HEALTH_PATH=/api/health

# Keep this at one for SQLite and the 4 GB prototype machine.
MATCH_CONCURRENCY=1
ALPHA_POKER_AUTO_RUN=true
ALPHA_POKER_AUTO_RUN_HANDS=200
ALPHA_POKER_AUTH_REQUIRED=true
ALPHA_POKER_RETAINED_HAND_RUNS=2
ALPHA_POKER_RETAINED_ARTIFACT_RUNS=30
# Set this before inviting a cohort. Leave blank for unrestricted local signup.
ALPHA_POKER_INVITE_CODE=
# Optional. Manual official runs are disabled under auth unless this is set.
ALPHA_POKER_OPERATOR_TOKEN=
LOG_LEVEL=info
